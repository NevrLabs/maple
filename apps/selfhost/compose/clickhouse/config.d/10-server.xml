<clickhouse>
  <!-- listen_host: see 00-listen.xml -->
  <logger><level>warning</level><console>1</console></logger>
  <!-- CT sizing (compose mem_limit 2500m). Memory ratio is of the cgroup limit. -->
  <max_server_memory_usage>1288490188</max_server_memory_usage>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>134217728</uncompressed_cache_size>
  <index_mark_cache_size>67108864</index_mark_cache_size>
  <max_concurrent_queries>50</max_concurrent_queries>
  <!-- BRIEF-perf: merge threads sized for 4 cores on Ceph (default 16 -> fewer concurrent merge writers). -->
  <background_pool_size>4</background_pool_size>
  <!-- keep system log tables from eating the 60G Ceph mount / IO. query_log 3 d, flushed every 30 s. -->
  <query_log replace="1"><database>system</database><table>query_log</table>
    <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 3 DAY</engine>
    <flush_interval_milliseconds>30000</flush_interval_milliseconds></query_log>
  <error_log replace="1"><database>system</database><table>error_log</table>
    <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 1 DAY</engine>
    <flush_interval_milliseconds>60000</flush_interval_milliseconds></error_log>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <part_log remove="1"/>
  <processors_profile_log remove="1"/>
  <query_views_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <query_metric_log remove="1"/>
  <asynchronous_insert_log remove="1"/>
  <background_schedule_pool_log remove="1"/>
  <latency_log remove="1"/>
  <blob_storage_log remove="1"/>
  <session_log remove="1"/>
  <crash_log remove="1"/>
  <merge_tree>
    <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
    <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
  </merge_tree>
</clickhouse>
