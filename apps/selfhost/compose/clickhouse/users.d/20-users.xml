<clickhouse>
  <profiles>
    <runtime>
      <readonly>2</readonly>
      <max_execution_time>60</max_execution_time>
      <max_memory_usage>1500000000</max_memory_usage>
      <max_rows_to_read>2000000000</max_rows_to_read>
    </runtime>
    <ingest>
      <max_memory_usage>1000000000</max_memory_usage>
      <async_insert>1</async_insert>
      <wait_for_async_insert>1</wait_for_async_insert>
    </ingest>
  </profiles>
  <users>
    <default remove="1"/>
    <maple_admin>
      <password from_env="CH_ADMIN_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile><quota>default</quota>
      <access_management>1</access_management>
    </maple_admin>
    <maple_runtime>
      <password from_env="CH_RUNTIME_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>runtime</profile><quota>default</quota>
      <grants><query>GRANT SELECT ON maple.*</query></grants>
    </maple_runtime>
    <maple_ingest>
      <password from_env="CH_INGEST_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>ingest</profile><quota>default</quota>
      <grants><query>GRANT SELECT, INSERT ON maple.*</query></grants>
    </maple_ingest>
  </users>
</clickhouse>
